# Genera con npm run password; NON inserire la password in chiaro.
ADMIN_PASSWORD_HASH=
# Almeno 32 caratteri casuali; openssl rand -hex 32
SESSION_SECRET=
# Un solo segmento: lettere, numeri, trattino, underscore (max 64).
ADMIN_PATH=/admin123
# Origine esatta pubblica, senza slash finale.
APP_ORIGIN=http://localhost:3000
# Store Vercel Blob PRIVATO, necessario in produzione.
BLOB_READ_WRITE_TOKEN=
# Regola Vercel Firewall Rate Limiting configurata, vedi README.
WAF_RATE_LIMIT_ID=deepdrop-auth
# Cron autenticato; almeno 32 caratteri casuali.
CRON_SECRET=
# Solo sviluppo: opzionale, default .deepdrop nella directory progetto.
# LOCAL_STORAGE_DIR=
